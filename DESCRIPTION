Package: OptSurvCutR
Type: Package
Title: Optimal Survival Cut-Point Discovery for Time-to-Event Analysis
Version: 0.1.8
Authors@R: 
    person(
        given = "Payton",
        family = "Yau",
        email = "tungon@gmail.com",
        role = c("aut", "cre", "cph"),
        comment = c(ORCID = "0000-0002-3283-0370") 
